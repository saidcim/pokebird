;
; audio_i2s.pio — MCLK generation and I2S microphone capture for the ES8311
;
; Adapted from audio_pio.pio in Waveshare's RP2350-Touch-LCD-3.5 example
; (MIT). Changes:
;   - GPIO numbers corrected for this board's schematic (LRCK/BCLK swapped)
;   - Capture (RX) path only; playback (TX) is not needed
;   - Configured for use with DMA
;
; CLOCK ARCHITECTURE (important):
;   The RP2350 generates MCLK only (GPIO3). The ES8311 is configured as the
;   I2S MASTER and derives BCLK (GPIO4) and LRCK (GPIO5) from MCLK itself.
;   So these PIO programs do NOT DRIVE the clock, they FOLLOW it.
;
; NOTE: the N in the `wait ... gpio N` instructions below is an ABSOLUTE GPIO
; number, not relative to the state machine's pin mapping. If the pins in
; board_config.h change, this file must be updated by hand — the static_asserts
; in audio_i2s.c make that impossible to forget.
;   GPIO4 = I2S_SCLK (BCLK),  GPIO5 = I2S_LRCK (WS)
;

; ── MCLK: a square wave on GPIO3 ────────────────────────────────────────────
; Five instructions run per loop; clkdiv is computed from that (audio_i2s.c).
.program mclk_pio
wrap_target:
    set pins, 1
    nop
    set pins, 0
    nop
    jmp wrap_target

; ── I2S RX: sample ASDOUT while following the ES8311's BCLK/LRCK ───────────
;
; The ES8311 is mono, so we read the LEFT channel only and skip the right one.
; Realigning from scratch on every frame makes it impossible for the alignment
; to drift, and it halves the FIFO traffic.
;
; IMPORTANT — DETERMINISM:
; The first version had `wait 1 gpio 4` immediately after the LRCK edge. The
; WAIT instruction is LEVEL triggered, not edge triggered: if BCLK happened to
; be high already the instruction passed through instantly, and if it was low
; it waited. So the bit offset depended on the moment of starting, and samples
; could be read shifted by one bit (which shows up as full-scale clipping).
; The fix: always wait for BCLK to FALL first, then catch the rising edge.
; That way we land on the same alignment no matter where we start.
;
; The autopush threshold is 16: one sample lands in the FIFO per frame. With
; left shifting, the first bit in (the MSB) ends up at bit 15, so the word's
; low 16 bits are the sample.
.program i2s_rx_pio
.wrap_target
    wait 1 gpio 5           ; LRCK high (right channel, or idle)
    wait 0 gpio 5           ; LRCK falling edge -> the left channel frame starts
    wait 0 gpio 4           ; wait for BCLK to fall (this fixes the alignment)
    wait 1 gpio 4           ; first rising edge: the I2S one-bit delay, discarded
    set x, 15
bitloop:
    wait 0 gpio 4
    wait 1 gpio 4           ; data is valid on BCLK's rising edge
    in pins, 1
    jmp x-- bitloop         ; runs 16 times
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void mclk_pio_program_init(PIO pio, uint sm, uint offset, uint mclk_pin) {
    pio_sm_config c = mclk_pio_program_get_default_config(offset);
    sm_config_set_out_pins(&c, mclk_pin, 1);
    sm_config_set_set_pins(&c, mclk_pin, 1);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_pindirs_with_mask(pio, sm, 1u << mclk_pin, 1u << mclk_pin);
    pio_sm_set_pins(pio, sm, 0);
    pio_gpio_init(pio, mclk_pin);
}

/* din_pin  : ES8311 ASDOUT  (GPIO2)
 * bclk_pin : ES8311 SCLK    (GPIO4)  — configured as an input only
 * lrck_pin : ES8311 LRCK    (GPIO5)  — configured as an input only
 * None of these are driven by PIO; the ES8311 is the master, so all three are
 * inputs. */
static inline void i2s_rx_pio_program_init(PIO pio, uint sm, uint offset,
                                           uint din_pin, uint bclk_pin, uint lrck_pin) {
    pio_sm_config c = i2s_rx_pio_program_get_default_config(offset);

    sm_config_set_in_pins(&c, din_pin);
    /* The first parameter is shift_right=false, i.e. shift LEFT: the first bit
     *   received goes to the word's top bit (matching I2S, which is MSB
     *   first).
     * autopush=true with a threshold of 16: one mono sample lands in the FIFO
     *   per frame. The word's low 16 bits are the sample. */
    sm_config_set_in_shift(&c, false, true, 16);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    pio_sm_init(pio, sm, offset, &c);

    uint mask = (1u << din_pin) | (1u << bclk_pin) | (1u << lrck_pin);
    pio_sm_set_pindirs_with_mask(pio, sm, 0, mask);   /* all inputs */

    pio_gpio_init(pio, din_pin);
    pio_gpio_init(pio, bclk_pin);
    pio_gpio_init(pio, lrck_pin);
}
%}
