# BirdNET segmentasyonu (M4 adim 3)
# .venv-birdnet: 3.11 sanal ortami + 260 MB model checkpoint'i
# birdnet_sonuc/: kayit basina bir CSV, 7.111 dosya
# segmentler.csv ve birdnet_slist.txt uretilebilir ciktilar
.venv-birdnet/
data/birdnet_sonuc/
data/birdnet_log/
data/segmentler.csv
data/birdnet_slist.txt
data/segment_ornek/

# Egitim kumesi (M4 adim 4) — hepsi uretilebilir cikti
# egitim/: 62 bin pencere, 739 MB (pencereler.npy)
# negatif/: ESC-50 (879 MB zip + 1.840 cevrilmis klip)
data/egitim/
data/negatif/

# M5 egitim ciktilari
# tur_agi_int8.h ve rapor.txt GIRER: firmware .h'yi derliyor, rapor kayittir.
