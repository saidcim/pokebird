# Derleme çıktıları
build/
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map

# Vendor edilmiş SDK — depoya girmez, cmake/setup ile çekilir
third_party/pico-sdk/
third_party/lvgl/

# Eğitim boru hattı — indirilen ses verileri ve API önbelleği çok büyük.
# data/species_istanbul.csv GİRER: küçük ve eleme kararlarını taşıyor.
data/xc/
data/cache/
tools/data/
tools/downloads/
tools/runs/
*.wav
*.mp3
*.tflite
__pycache__/
*.pyc
.venv/

# Editör
.vscode/
.idea/
compile_commands.json

# Referans olarak buraya kopyalanan baska projeler
rsvpnano/

# Xeno-canto API anahtari — asla depoya girmez
data/.xc_key

# M4 boru hatti calisma gunlugu
data/m4_run.log
data/wav/
data/convert.log

# BirdNET segmentasyonu (M4 adim 3)
# .venv-birdnet: 3.11 sanal ortami + 260 MB model checkpoint'i
# birdnet_sonuc/: kayit basina bir CSV, 7.111 dosya
# segmentler.csv ve birdnet_slist.txt uretilebilir ciktilar
.venv-birdnet/
data/birdnet_sonuc/
data/birdnet_log/
data/segmentler.csv
data/birdnet_slist.txt
data/segment_ornek/

# Egitim kumesi (M4 adim 4) — hepsi uretilebilir cikti
# egitim/: 62 bin pencere, 739 MB (pencereler.npy)
# negatif/: ESC-50 (879 MB zip + 1.840 cevrilmis klip)
data/egitim/
data/negatif/

# M5 egitim ciktilari
# tur_agi_int8.h ve rapor.txt GIRER: firmware .h'yi derliyor, rapor kayittir.
# .keras her egitimde yeniden uretiliyor ve buyuk; ilerleme.html gecici pano.
models/*.keras
models/ilerleme.html
models/test_olasilik.npy

# M7 Asama-1 ikili ag — ayni gerekce
# ikili_agi_int8.h ve ikili_rapor.txt GIRER.
tools/egitim_pano.html

# M6 — TFLM ve bagimliliklari. Hepsi vendor edilmis ucuncu taraf, surumler
# cmake/tflm.cmake'te sabitlenmis; kurulum README'de.
third_party/tflite-micro/
third_party/flatbuffers/
third_party/gemmlowp/
third_party/ruy/
third_party/cmsis-nn/

# A/B probe derlemeleri (bkz. §5.17 uc kosuluk A/B)
build-*/

# Arayuz onizlemesi (host) — derleme ciktisi ve uretilen goruntuler
tools/arayuz_onizle/build/

# M8 saha turlari (docs/M8_SAHA_PROTOKOLU.md)
# cihaz.log / cihaz.csv / uyum.csv / oturum.txt GIRER: turun kaydi onlar.
# Telefon kaydi (*.wav zaten yukarida) ve BirdNET ciktisi uretilebilir/buyuk.
saha/*/ses/
saha/*/birdnet/
